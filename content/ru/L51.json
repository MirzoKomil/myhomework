 "dialog": {
  "title": "Ско́лько у тебя́…? (Senda nechta…?)",
  "lines": [
   {
    "who": "Анто́н",
    "ru": "Нигора́, у тебя́ больша́я семья́?",
    "uz": "Nigora, oilang kattami?"
   },
   {
    "who": "Нигора́",
    "ru": "Да! У меня́ три бра́та и две сестры́. А у тебя́?",
    "uz": "Ha! Uchta akam-ukam va ikkita opa-singlim bor. Seniki-chi?"
   },
   {
    "who": "Анто́н",
    "ru": "У меня́ оди́н брат и одна́ сестра́. И у меня́ мно́го друзе́й.",
    "uz": "Bitta akam va bitta singlim bor. Do'stlarim ham ko'p."
   },
   {
    "who": "Нигора́",
    "ru": "А ско́лько у тебя́ дете́й?",
    "uz": "Nechta farzanding bor?"
   },
   {
    "who": "Анто́н",
    "ru": "Пока́ дете́й нет. По выходны́м я гуля́ю с жено́й в па́рке.",
    "uz": "Hozircha bolalarim yo'q. Dam olish kunlari xotinim bilan parkda sayr qilaman."
   },
   {
    "who": "Нигора́",
    "ru": "Приходи́те к нам с жено́й! У нас мно́го дете́й — бу́дет ве́село.",
    "uz": "Xotiningiz bilan bizga keling! Bizda bolalar ko'p — qiziq bo'ladi."
   }
  ]
 },
