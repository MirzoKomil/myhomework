   },
   {
    "who": "Нигора́",
    "ru": "Пове́сь её в гости́ной, над дива́ном. Бу́дет о́чень ую́тно!",
    "uz": "Uni mehmonxonaga, divan ustiga os. Juda shinam bo'ladi!"
   }
  ]
