   "id": "L36-d2",
   "title_ru": "Кем ты хо́чешь стать?",
   "title_uz": "Kim bo'lmoqchisan?",
   "intro_uz": "Ikkinchi dialog. O'qituvchi Sanjardan so'rayapti: kelajakda kim bo'lmoqchisan? Tinglang.",
   "speakers": [
    {
     "name": "Санжа́р",
     "gender": "m"
