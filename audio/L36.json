   ],
   "lines": [
    {
     "who": "Учи́тельница",
     "ru": "Санжа́р, кем ты хо́чешь стать?",
     "uz": "Sanjar, kim bo'lmoqchisan?"
    },
    {
     "who": "Санжа́р",
     "ru": "Я хочу́ стать врачо́м.",
     "uz": "Men shifokor bo'lmoqchiman."
    },
    {
     "who": "Учи́тельница",
     "ru": "Врачо́м? Почему́?",
     "uz": "Shifokormi? Nega?"
    },
    {
     "who": "Санжа́р",
     "ru": "Мой па́па рабо́тает врачо́м. Мне нра́вится его́ рабо́та.",
     "uz": "Dadam shifokor bo'lib ishlaydi. Menga uning ishi yoqadi."
    },
    {
     "who": "Учи́тельница",
     "ru": "А где он рабо́тает?",
     "uz": "U qayerda ishlaydi?"
    },
    {
     "who": "Санжа́р",
     "ru": "В больни́це, в це́нтре. А вы всегда́ рабо́тали учи́телем?",
     "uz": "Markazdagi kasalxonada. Siz doim o'qituvchi bo'lib ishlaganmisiz?"
    },
    {
     "who": "Учи́тельница",
     "ru": "Нет, ра́ньше я рабо́тала журнали́стом.",
     "uz": "Yo'q, oldin jurnalist bo'lib ishlaganman."
