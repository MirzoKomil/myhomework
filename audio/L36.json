    },
    {
     "who": "Анто́н",
     "ru": "Я мечта́ю о свое́й фи́рме. А вы кем рабо́таете?",
     "uz": "O'z firmam haqida orzu qilaman. Siz kim bo'lib ishlaysiz?"
    },
    {
     "who": "Мади́на",
     "ru": "Я рабо́таю учи́телем. Но хочу́ стать дире́ктором шко́лы.",
     "uz": "O'qituvchi bo'lib ishlayman. Lekin maktab direktori bo'lmoqchiman."
    },
    {
     "who": "Анто́н",
     "ru": "Отли́чная мечта́! Уда́чи вам!",
     "uz": "Ajoyib orzu! Sizga omad!"
