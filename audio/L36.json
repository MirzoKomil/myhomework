   "title_ru": "Но́вая колле́га",
   "title_uz": "Yangi hamkasb",
   "intro_uz": "Birinchi dialog. Ishxonaga yangi hamkasb keldi. Abdulaziz u bilan tanishadi. Tinglang.",
   "speakers": [
    {
     "name": "Абдулази́з",
     "gender": "m"
    },
    {
     "name": "Дильно́за",
     "gender": "f"
    }
   ],
   "lines": [
    {
     "who": "Абдулази́з",
     "ru": "Здра́вствуйте! Вы на́ша но́вая колле́га?",
     "uz": "Assalomu alaykum! Siz yangi hamkasbimizmisiz?"
    },
    {
     "who": "Дильно́за",
     "ru": "Да, меня́ зову́т Дильно́за. Я рабо́таю бухга́лтером.",
     "uz": "Ha, ismim Dilnoza. Men buxgalter bo'lib ishlayman."
    },
    {
     "who": "Абдулази́з",
     "ru": "О́чень прия́тно. Я Абдулази́з, рабо́таю ме́неджером. Я здесь то́же неда́вно — из Андижа́на.",
     "uz": "Juda xursandman. Men Abdulaziz, menejer bo'lib ishlayman. Men ham bu yerda yangiman — Andijondan keldim."
    },
    {
     "who": "Дильно́за",
     "ru": "А кто наш нача́льник?",
     "uz": "Boshlig'imiz kim?"
    },
    {
     "who": "Абдулази́з",
     "ru": "Шавка́т Ахме́дович. Он рабо́тает дире́ктором три го́да. Он до́брый.",
     "uz": "Shavkat Axmedovich. U uch yildan beri direktor bo'lib ishlaydi. U mehribon."
    },
    {
     "who": "Дильно́за",
     "ru": "Хорошо́! Рабо́чий день начина́ется в де́вять?",
     "uz": "Yaxshi! Ish kuni soat to'qqizda boshlanadimi?"
    },
    {
     "who": "Абдулази́з",
     "ru": "Да, в де́вять, и конча́ется в шесть.",
     "uz": "Ha, to'qqizda, oltida tugaydi."
    },
    {
     "who": "Дильно́за",
     "ru": "Отли́чно. Мне нра́вится рабо́тать с людьми́.",
     "uz": "Ajoyib. Menga odamlar bilan ishlash yoqadi."
    }
   ],
   "questions": [
