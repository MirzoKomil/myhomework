   "lines": [
    {
     "who": "Абдулази́з",
     "ru": "До́брый ве́чер! У вас есть свобо́дный стол?",
     "uz": "Xayrli kech! Bo'sh stol bormi?"
    },
    {
     "who": "Официа́нтка",
     "ru": "Да, есть. Вот, у окна́.",
     "uz": "Ha, bor. Mana, deraza yonida."
    },
    {
     "who": "Абдулази́з",
     "ru": "Спаси́бо. Мо́жно меню́, пожа́луйста?",
     "uz": "Rahmat. Menyu bersangiz?"
    },
    {
     "who": "Официа́нтка",
     "ru": "Вот меню́. Что бу́дете пить?",
     "uz": "Mana menyu. Nima ichasiz?"
    },
    {
     "who": "Абдулази́з",
     "ru": "Мне, пожа́луйста, зелёный чай.",
     "uz": "Menga ko'k choy, iltimos."
    },
    {
     "who": "Официа́нтка",
     "ru": "Хорошо́. А что бу́дете есть?",
     "uz": "Xo'p. Nima yeysiz?"
