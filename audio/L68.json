   "lines": [
    {
     "who": "Сотру́дник",
     "ru": "Здра́вствуйте! Чем могу́ помо́чь?",
     "uz": "Assalomu alaykum! Qanday yordam bera olaman?"
    },
    {
     "who": "Нигора́",
     "ru": "Моя́ ка́рта заблоки́рована. Я не могу́ снять де́ньги.",
     "uz": "Kartam bloklangan. Pul yecha olmayapman."
    },
    {
     "who": "Сотру́дник",
     "ru": "Ваш па́спорт, пожа́луйста… Да, вы три ра́за ввели́ непра́вильный пин-код.",
     "uz": "Pasportingiz, iltimos… Ha, siz uch marta noto'g'ri PIN-kod kiritgansiz."
    },
    {
     "who": "Нигора́",
     "ru": "Ой! Что мне ну́жно сде́лать?",
     "uz": "Voy! Nima qilishim kerak?"
    },
    {
     "who": "Сотру́дник",
     "ru": "Напиши́те заявле́ние, и мы разблоки́руем ка́рту.",
     "uz": "Ariza yozing, biz kartani blokdan chiqaramiz."
    },
    {
     "who": "Нигора́",
     "ru": "Ско́лько э́то займёт вре́мени?",
     "uz": "Bu qancha vaqt oladi?"
    },
    {
     "who": "Сотру́дник",
     "ru": "Оди́н день. За́втра всё бу́дет гото́во.",
     "uz": "Bir kun. Ertaga hammasi tayyor bo'ladi."
    },
    {
     "who": "Нигора́",
     "ru": "Спаси́бо за по́мощь!",
     "uz": "Yordamingiz uchun rahmat!"
    }
