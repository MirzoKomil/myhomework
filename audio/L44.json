   "lines": [
    {
     "who": "Тиму́р",
     "ru": "Здра́вствуйте! Оди́н биле́т до Самарка́нда, пожа́луйста.",
     "uz": "Assalomu alaykum! Samarqandgacha bitta chipta, iltimos."
