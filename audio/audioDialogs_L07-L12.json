{"l1784055280406-6": [{"id": "bk-L07-d1", "title": "Где мои́ ключи́? — Kalitlarim qayerda?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L07_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L07.jpg", "repeatFrom": 21.91, "durationSec": 52, "lines": [{"ru": "Нигора́, где мои́ ключи́?", "uz": "Nigora, kalitlarim qayerda?", "start": 8.98, "speaker": "Абдулази́з", "repeatStart": 26.67}, {"ru": "Твои́ ключи́? Вот они́.", "uz": "Kalitlaringmi? Mana ular.", "start": 10.91, "speaker": "Нигора́", "repeatStart": 30.7}, {"ru": "Спаси́бо! А где моя́ ку́ртка?", "uz": "Rahmat! Kurtkam qayerda?", "start": 12.76, "speaker": "Абдулази́з", "repeatStart": 34.55}, {"ru": "Вот твоя́ ку́ртка.", "uz": "Mana kurtkang.", "start": 15.21, "speaker": "Нигора́", "repeatStart": 39.75}, {"ru": "А э́то мой телефо́н?", "uz": "Bu mening telefonimmi?", "start": 16.66, "speaker": "Абдулази́з", "repeatStart": 42.95}, {"ru": "Нет, э́то мой телефо́н! Твой там.", "uz": "Yo'q, bu mening telefonim! Seniki u yerda.", "start": 18.23, "speaker": "Нигора́", "repeatStart": 46.27}]}, {"id": "bk-L07-d2", "title": "Фо́то се́мьи — Oilaviy surat", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L07_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L07.jpg", "repeatFrom": 24.11, "durationSec": 60, "lines": [{"ru": "Дильно́за, э́то ва́ше фо́то?", "uz": "Dilnoza, bu sizning suratingizmi?", "start": 9.1, "speaker": "Анто́н", "repeatStart": 28.87}, {"ru": "Да, э́то моё фо́то. Э́то моя́ семья́.", "uz": "Ha, bu mening suratim. Bu mening oilam.", "start": 11.57, "speaker": "Дильно́за", "repeatStart": 34.11}, {"ru": "А кто э́то?", "uz": "Bu kim?", "start": 15.3, "speaker": "Анто́н", "repeatStart": 42.78}, {"ru": "Э́то мой брат. А э́то его́ жена́.", "uz": "Bu mening akam. Bu esa uning xotini.", "start": 16.47, "speaker": "Дильно́за", "repeatStart": 45.7}, {"ru": "А э́то ваш го́род?", "uz": "Bu sizning shahringizmi?", "start": 19.22, "speaker": "Анто́н", "repeatStart": 51.57}, {"ru": "Да, э́то наш го́род — Андижа́н.", "uz": "Ha, bu bizning shahrimiz — Andijon.", "start": 20.57, "speaker": "Дильно́за", "repeatStart": 54.67}]}, {"id": "bk-L07-d3", "title": "В гости́нице — Mehmonxonada", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L07_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L07.jpg", "repeatFrom": 25.53, "durationSec": 69, "lines": [{"ru": "Здра́вствуйте! Ваш па́спорт, пожа́луйста.", "uz": "Assalomu alaykum! Pasportingizni bering, iltimos.", "start": 6.84, "speaker": "Администра́тор", "repeatStart": 30.29}, {"ru": "Здра́вствуйте. Вот мой па́спорт.", "uz": "Assalomu alaykum. Mana pasportim.", "start": 10.99, "speaker": "Бобу́р", "repeatStart": 40.22}, {"ru": "Спаси́бо. Вот ваш ключ.", "uz": "Rahmat. Mana kalitingiz.", "start": 13.5, "speaker": "Администра́тор", "repeatStart": 45.55}, {"ru": "Спаси́бо. А где моя́ ко́мната?", "uz": "Rahmat. Xonam qayerda?", "start": 16.03, "speaker": "Бобу́р", "repeatStart": 50.93}, {"ru": "Ва́ша ко́мната там. Э́то ва́ша су́мка?", "uz": "Xonangiz u yerda. Bu sizning sumkangizmi?", "start": 18.56, "speaker": "Администра́тор", "repeatStart": 56.31}, {"ru": "Да, э́то моя́ су́мка. И э́то мои́ ве́щи.", "uz": "Ha, bu mening sumkam. Bular ham mening narsalarim.", "start": 21.39, "speaker": "Бобу́р", "repeatStart": 62.37}]}], "l1784055280406-7": [{"id": "bk-L08-d1", "title": "Чей э́то телефо́н? — Bu kimning telefoni?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L08_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L08.jpg", "repeatFrom": 25.22, "durationSec": 63, "lines": [{"ru": "Дильно́за, чей э́то телефо́н?", "uz": "Dilnoza, bu kimning telefoni?", "start": 8.66, "speaker": "Анто́н", "repeatStart": 29.98}, {"ru": "Э́то не мой телефо́н. Мой здесь.", "uz": "Bu mening telefonim emas. Meniki shu yerda.", "start": 11.11, "speaker": "Дильно́за", "repeatStart": 35.18}, {"ru": "А чья э́то су́мка?", "uz": "Bu kimning sumkasi?", "start": 13.96, "speaker": "Анто́н", "repeatStart": 41.28}, {"ru": "Э́то моя́ су́мка. Спаси́бо!", "uz": "Bu mening sumkam. Rahmat!", "start": 15.59, "speaker": "Дильно́за", "repeatStart": 44.66}, {"ru": "А чьи э́то ключи́?", "uz": "Bu kimning kalitlari?", "start": 17.52, "speaker": "Анто́н", "repeatStart": 48.69}, {"ru": "Не зна́ю. Э́то не мои́ ключи́.", "uz": "Bilmayman. Bu mening kalitlarim emas.", "start": 19.63, "speaker": "Дильно́за", "repeatStart": 53.12}, {"ru": "А, э́то мои́ ключи́!", "uz": "A, bu mening kalitlarim-ku!", "start": 21.88, "speaker": "Анто́н", "repeatStart": 57.87}]}, {"id": "bk-L08-d2", "title": "В оте́ле — Otelda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L08_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L08.jpg", "repeatFrom": 19.31, "durationSec": 49, "lines": [{"ru": "Извини́те, чей э́то па́спорт?", "uz": "Kechirasiz, bu kimning pasporti?", "start": 6.62, "speaker": "Администра́тор", "repeatStart": 24.07}, {"ru": "Э́то мой па́спорт. Спаси́бо!", "uz": "Bu mening pasportim. Rahmat!", "start": 8.67, "speaker": "Тури́ст", "repeatStart": 28.37}, {"ru": "А чьи э́то докуме́нты?", "uz": "Bu kimning hujjatlari?", "start": 10.72, "speaker": "Администра́тор", "repeatStart": 32.67}, {"ru": "Э́то на́ши докуме́нты.", "uz": "Bu bizning hujjatlarimiz.", "start": 12.49, "speaker": "Тури́ст", "repeatStart": 36.34}, {"ru": "А чья э́то ку́ртка?", "uz": "Bu kimning kurtkasi?", "start": 14.06, "speaker": "Администра́тор", "repeatStart": 39.66}, {"ru": "Э́то не моя́ ку́ртка. Э́то её ку́ртка.", "uz": "Bu mening kurtkam emas. Bu uning kurtkasi.", "start": 15.63, "speaker": "Тури́ст", "repeatStart": 42.98}]}, {"id": "bk-L08-d3", "title": "Чьё э́то я́блоко? — Bu kimning olmasi?", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L08_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L08.jpg", "repeatFrom": 21.33, "durationSec": 51, "lines": [{"ru": "Сардо́р, чьи э́то кни́ги?", "uz": "Sardor, bu kimning kitoblari?", "start": 8.44, "speaker": "Нигора́", "repeatStart": 26.09}, {"ru": "Э́то мои́ кни́ги, ма́ма.", "uz": "Bu mening kitoblarim, oyi.", "start": 10.77, "speaker": "Сардо́р", "repeatStart": 31.02}, {"ru": "А чьё э́то я́блоко?", "uz": "Bu kimning olmasi?", "start": 12.52, "speaker": "Нигора́", "repeatStart": 34.65}, {"ru": "Э́то моё я́блоко!", "uz": "Bu mening olmam!", "start": 14.17, "speaker": "Сардо́р", "repeatStart": 38.05}, {"ru": "А чей э́то телефо́н?", "uz": "Bu kimning telefoni?", "start": 15.72, "speaker": "Нигора́", "repeatStart": 41.34}, {"ru": "Э́то не мой телефо́н. Э́то твой телефо́н, ма́ма!", "uz": "Bu mening telefonim emas. Bu sizning telefoningiz, oyi!", "start": 17.27, "speaker": "Сардо́р", "repeatStart": 44.65}]}], "l1784055280406-8": [{"id": "bk-L09-d1", "title": "Вы говори́те по-ру́сски? — Ruscha gapirasizmi?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L09_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L09.jpg", "repeatFrom": 21.63, "durationSec": 54, "lines": [{"ru": "Нигора́, вы говори́те по-ру́сски?", "uz": "Nigora, siz ruscha gapirasizmi?", "start": 7.66, "speaker": "Анто́н", "repeatStart": 26.39}, {"ru": "Да, говорю́. Я учу́ ру́сский.", "uz": "Ha, gapiraman. Men rus tilini o'rganyapman.", "start": 9.85, "speaker": "Нигора́", "repeatStart": 31.0}, {"ru": "А Абдулази́з говори́т по-ру́сски?", "uz": "Abdulaziz ruscha gapiradimi?", "start": 12.26, "speaker": "Анто́н", "repeatStart": 36.12}, {"ru": "Да, он то́же говори́т.", "uz": "Ha, u ham gapiradi.", "start": 14.27, "speaker": "Нигора́", "repeatStart": 40.33}, {"ru": "А де́ти?", "uz": "Bolalar-chi?", "start": 15.9, "speaker": "Анто́н", "repeatStart": 43.7}, {"ru": "Де́ти то́же у́чат ру́сский. Они́ ча́сто смо́трят мультфи́льмы.", "uz": "Bolalar ham rus tilini o'rganyapti. Ular tez-tez multfilm ko'rishadi.", "start": 17.03, "speaker": "Нигора́", "repeatStart": 46.59}]}, {"id": "bk-L09-d2", "title": "В кафе́ — Kafeda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L09_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L09.jpg", "repeatFrom": 25.21, "durationSec": 65, "lines": [{"ru": "Дильно́за, что ты пьёшь?", "uz": "Dilnoza, nima ichyapsan?", "start": 8.2, "speaker": "Бобу́р", "repeatStart": 29.97}, {"ru": "Я пью чай. Я люблю́ чай.", "uz": "Choy ichyapman. Men choyni yaxshi ko'raman.", "start": 11.33, "speaker": "Дильно́за", "repeatStart": 37.1}, {"ru": "А я пью ко́фе. Я ча́сто пью ко́фе.", "uz": "Men esa qahva ichyapman. Men tez-tez qahva ichaman.", "start": 13.76, "speaker": "Бобу́р", "repeatStart": 42.26}, {"ru": "Бобу́р, ты ви́дишь? Там Анто́н!", "uz": "Bobur, ko'ryapsanmi? U yerda Anton!", "start": 17.25, "speaker": "Дильно́за", "repeatStart": 49.8}, {"ru": "Да, ви́жу. Он говори́т по телефо́ну.", "uz": "Ha, ko'ryapman. U telefonda gaplashyapti.", "start": 19.46, "speaker": "Бобу́р", "repeatStart": 54.46}, {"ru": "Он ча́сто говори́т по телефо́ну!", "uz": "U tez-tez telefonda gaplashadi!", "start": 22.11, "speaker": "Дильно́за", "repeatStart": 60.11}]}, {"id": "bk-L09-d3", "title": "Подру́га из Ташке́нта — Toshkentlik dugona", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L09_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L09.jpg", "repeatFrom": 25.35, "durationSec": 63, "lines": [{"ru": "Дильно́за, где вы живёте?", "uz": "Dilnoza, qayerda yashaysiz?", "start": 8.86, "speaker": "Анто́н", "repeatStart": 30.11}, {"ru": "Я живу́ в Ташке́нте. Я рабо́таю здесь.", "uz": "Men Toshkentda yashayman. Shu yerda ishlayman.", "start": 11.09, "speaker": "Дильно́за", "repeatStart": 34.81}, {"ru": "Вы ча́сто звони́те домо́й?", "uz": "Uyingizga tez-tez qo'ng'iroq qilasizmi?", "start": 14.32, "speaker": "Анто́н", "repeatStart": 41.77}, {"ru": "Да, ча́сто. Мы говори́м по-узбе́кски.", "uz": "Ha, tez-tez. Biz o'zbekcha gaplashamiz.", "start": 16.11, "speaker": "Дильно́за", "repeatStart": 45.48}, {"ru": "А по-ру́сски вы говори́те хорошо́!", "uz": "Ruschani esa yaxshi gapirasiz!", "start": 19.1, "speaker": "Анто́н", "repeatStart": 51.9}, {"ru": "Спаси́бо! Я учу́ слова́ и смотрю́ кино́.", "uz": "Rahmat! So'z yodlayman va kino ko'raman.", "start": 21.21, "speaker": "Дильно́за", "repeatStart": 56.33}]}], "l1784055280406-9": [{"id": "bk-L10-d1", "title": "Что ты лю́бишь де́лать? — Nima qilishni yaxshi ko'rasan?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L10_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L10.jpg", "repeatFrom": 28.89, "durationSec": 74, "lines": [{"ru": "Дильно́за, что ты лю́бишь де́лать?", "uz": "Dilnoza, nima qilishni yaxshi ko'rasan?", "start": 8.92, "speaker": "Бобу́р", "repeatStart": 33.65}, {"ru": "Я люблю́ чита́ть и гуля́ть. А ты?", "uz": "Men kitob o'qish va sayr qilishni yaxshi ko'raman. Sen-chi?", "start": 11.15, "speaker": "Дильно́за", "repeatStart": 38.35}, {"ru": "Я люблю́ спорт. Я люблю́ игра́ть в футбо́л.", "uz": "Men sportni yaxshi ko'raman. Futbol o'ynashni yaxshi ko'raman.", "start": 13.88, "speaker": "Бобу́р", "repeatStart": 44.19}, {"ru": "А заря́дку ты де́лаешь?", "uz": "Badantarbiya qilasanmi?", "start": 17.47, "speaker": "Дильно́за", "repeatStart": 51.95}, {"ru": "Да, я ча́сто де́лаю заря́дку.", "uz": "Ha, tez-tez badantarbiya qilaman.", "start": 19.26, "speaker": "Бобу́р", "repeatStart": 55.66}, {"ru": "Молоде́ц! А я не люблю́ спорт.", "uz": "Barakalla! Men esa sportni yoqtirmayman.", "start": 21.71, "speaker": "Дильно́за", "repeatStart": 60.87}, {"ru": "А что ты лю́бишь смотре́ть?", "uz": "Nima ko'rishni yaxshi ko'rasan?", "start": 24.42, "speaker": "Бобу́р", "repeatStart": 66.65}, {"ru": "Я люблю́ смотре́ть фи́льмы.", "uz": "Film ko'rishni yaxshi ko'raman.", "start": 26.01, "speaker": "Дильно́за", "repeatStart": 69.99}]}, {"id": "bk-L10-d2", "title": "Ве́чером до́ма — Kechqurun uyda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L10_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L10.jpg", "repeatFrom": 28.88, "durationSec": 75, "lines": [{"ru": "Что ты смо́тришь?", "uz": "Nima ko'ryapsan?", "start": 8.54, "speaker": "Нигора́", "repeatStart": 33.64}, {"ru": "Я смотрю́ но́вости. Я люблю́ но́вости.", "uz": "Yangiliklarni ko'ryapman. Yangiliklarni yaxshi ko'raman.", "start": 10.07, "speaker": "Абдулази́з", "repeatStart": 36.92}, {"ru": "А я не люблю́ но́вости. Я люблю́ фи́льмы.", "uz": "Men esa yangiliklarni yoqtirmayman. Filmlarni yaxshi ko'raman.", "start": 13.34, "speaker": "Нигора́", "repeatStart": 43.96}, {"ru": "А что де́лают де́ти?", "uz": "Bolalar nima qilyapti?", "start": 16.55, "speaker": "Абдулази́з", "repeatStart": 50.87}, {"ru": "Сардо́р слу́шает пе́сни. Маржона́ пи́шет дикта́нт.", "uz": "Sardor qo'shiq tinglayapti. Marjona diktant yozyapti.", "start": 18.14, "speaker": "Нигора́", "repeatStart": 54.21}, {"ru": "Хорошо́. Ты пьёшь чай и́ли ко́фе?", "uz": "Yaxshi. Choy ichasanmi yoki qahva?", "start": 21.93, "speaker": "Абдулази́з", "repeatStart": 62.43}, {"ru": "Ко́фе, пожа́луйста. Я люблю́ ко́фе.", "uz": "Qahva, iltimos. Men qahvani yaxshi ko'raman.", "start": 25.26, "speaker": "Нигора́", "repeatStart": 69.61}]}, {"id": "bk-L10-d3", "title": "Вы лю́бите му́зыку? — Musiqani yaxshi ko'rasizmi?", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L10_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L10.jpg", "repeatFrom": 24.16, "durationSec": 61, "lines": [{"ru": "Дильно́за, вы лю́бите му́зыку?", "uz": "Dilnoza, musiqani yaxshi ko'rasizmi?", "start": 8.0, "speaker": "Анто́н", "repeatStart": 28.92}, {"ru": "Да, о́чень люблю́. Я ча́сто слу́шаю пе́сни.", "uz": "Ha, juda yaxshi ko'raman. Tez-tez qo'shiq tinglayman.", "start": 10.51, "speaker": "Дильно́за", "repeatStart": 34.26}, {"ru": "А вы поёте?", "uz": "Qo'shiq aytasizmi?", "start": 13.8, "speaker": "Анто́н", "repeatStart": 41.34}, {"ru": "Нет, я не пою́. А вы?", "uz": "Yo'q, aytmayman. Siz-chi?", "start": 15.13, "speaker": "Дильно́за", "repeatStart": 44.42}, {"ru": "Я пою́, но пло́хо!", "uz": "Aytaman, lekin yomon!", "start": 17.32, "speaker": "Анто́н", "repeatStart": 49.04}, {"ru": "А что вы лю́бите смотре́ть?", "uz": "Nima ko'rishni yaxshi ko'rasiz?", "start": 19.29, "speaker": "Дильно́за", "repeatStart": 53.16}, {"ru": "Я люблю́ смотре́ть футбо́л.", "uz": "Futbol ko'rishni yaxshi ko'raman.", "start": 21.14, "speaker": "Анто́н", "repeatStart": 57.01}]}], "l1784055280406-10": [{"id": "bk-L11-d1", "title": "Где мой телефо́н? — Telefonim qayerda?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L11_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L11.jpg", "repeatFrom": 20.87, "durationSec": 51, "lines": [{"ru": "Нигора́, где мой телефо́н?", "uz": "Nigora, telefonim qayerda?", "start": 7.82, "speaker": "Абдулази́з", "repeatStart": 25.63}, {"ru": "Твой телефо́н на столе́.", "uz": "Telefoning stol ustida.", "start": 10.07, "speaker": "Нигора́", "repeatStart": 30.38}, {"ru": "А где ключи́? В су́мке?", "uz": "Kalitlar-chi? Sumkadami?", "start": 11.78, "speaker": "Абдулази́з", "repeatStart": 33.91}, {"ru": "Нет, ключи́ в ку́ртке.", "uz": "Yo'q, kalitlar kurtkada.", "start": 14.05, "speaker": "Нигора́", "repeatStart": 38.71}, {"ru": "А моя́ су́мка? Где она́?", "uz": "Sumkam-chi? U qayerda?", "start": 16.02, "speaker": "Абдулази́з", "repeatStart": 42.83}, {"ru": "Твоя́ су́мка в маши́не.", "uz": "Sumkang mashinada.", "start": 18.13, "speaker": "Нигора́", "repeatStart": 47.26}]}, {"id": "bk-L11-d2", "title": "Где вы рабо́таете? — Qayerda ishlaysiz?", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L11_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L11.jpg", "repeatFrom": 23.27, "durationSec": 60, "lines": [{"ru": "Дильно́за, где вы рабо́таете?", "uz": "Dilnoza, qayerda ishlaysiz?", "start": 7.34, "speaker": "Анто́н", "repeatStart": 28.03}, {"ru": "Я рабо́таю в шко́ле. А вы?", "uz": "Men maktabda ishlayman. Siz-chi?", "start": 9.99, "speaker": "Дильно́за", "repeatStart": 33.68}, {"ru": "Я рабо́таю в о́фисе. А где вы живёте?", "uz": "Men ofisda ishlayman. Qayerda yashaysiz?", "start": 12.28, "speaker": "Анто́н", "repeatStart": 38.52}, {"ru": "Я живу́ в Ташке́нте, а ма́ма — в Андижа́не.", "uz": "Men Toshkentda yashayman, oyim esa — Andijonda.", "start": 15.61, "speaker": "Дильно́за", "repeatStart": 45.7}, {"ru": "А где рабо́тает ваш брат?", "uz": "Akangiz qayerda ishlaydi?", "start": 18.46, "speaker": "Анто́н", "repeatStart": 51.8}, {"ru": "Он рабо́тает на заво́де.", "uz": "U zavodda ishlaydi.", "start": 20.43, "speaker": "Дильно́за", "repeatStart": 55.92}]}, {"id": "bk-L11-d3", "title": "Ты у́тром до́ма? — Ertalab uydamisan?", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L11_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L11.jpg", "repeatFrom": 24.97, "durationSec": 58, "lines": [{"ru": "Нигора́, ты у́тром до́ма?", "uz": "Nigora, ertalab uydamisan?", "start": 10.94, "speaker": "Бобу́р", "repeatStart": 29.73}, {"ru": "Нет, у́тром я на рабо́те.", "uz": "Yo'q, ertalab ishdaman.", "start": 12.79, "speaker": "Нигора́", "repeatStart": 33.58}, {"ru": "А днём? Ты в о́фисе?", "uz": "Kunduzi-chi? Ofisdamisan?", "start": 15.1, "speaker": "Бобу́р", "repeatStart": 38.47}, {"ru": "Днём я в магази́не.", "uz": "Kunduzi do'kondaman.", "start": 17.21, "speaker": "Нигора́", "repeatStart": 42.9}, {"ru": "А ве́чером?", "uz": "Kechqurun-chi?", "start": 19.16, "speaker": "Бобу́р", "repeatStart": 46.97}, {"ru": "Ве́чером я до́ма. А но́чью я сплю!", "uz": "Kechqurun uydaman. Kechasi esa uxlayman!", "start": 20.27, "speaker": "Нигора́", "repeatStart": 49.83}]}], "l1784055280406-11": [{"id": "bk-L12-d1", "title": "Где ты? — Qayerdasan?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L12_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L12.jpg", "repeatFrom": 20.61, "durationSec": 50, "lines": [{"ru": "Алло́! Где ты?", "uz": "Allo! Qayerdasan?", "start": 7.76, "speaker": "Нигора́", "repeatStart": 25.37}, {"ru": "Я в кафе́, в це́нтре.", "uz": "Kafedaman, markazda.", "start": 9.53, "speaker": "Абдулази́з", "repeatStart": 29.04}, {"ru": "Что ты там де́лаешь?", "uz": "U yerda nima qilyapsan?", "start": 11.4, "speaker": "Нигора́", "repeatStart": 32.93}, {"ru": "Я обе́даю. А ты где?", "uz": "Tushlik qilyapman. Sen qayerdasan?", "start": 12.99, "speaker": "Абдулази́з", "repeatStart": 36.27}, {"ru": "Я до́ма. Я гото́влю у́жин.", "uz": "Uydaman. Kechki ovqat tayyorlayapman.", "start": 15.02, "speaker": "Нигора́", "repeatStart": 40.53}, {"ru": "Отли́чно! Ве́чером я до́ма.", "uz": "Zo'r! Kechqurun uyda bo'laman.", "start": 17.29, "speaker": "Абдулази́з", "repeatStart": 45.32}]}, {"id": "bk-L12-d2", "title": "На стадио́не — Stadionda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L12_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L12.jpg", "repeatFrom": 23.32, "durationSec": 58, "lines": [{"ru": "Тиму́р, ты где?", "uz": "Timur, qayerdasan?", "start": 8.56, "speaker": "Дильно́за", "repeatStart": 28.08}, {"ru": "Я на стадио́не.", "uz": "Stadiondaman.", "start": 10.19, "speaker": "Тиму́р", "repeatStart": 31.46}, {"ru": "Что вы там де́лаете?", "uz": "U yerda nima qilyapsizlar?", "start": 11.72, "speaker": "Дильно́за", "repeatStart": 34.74}, {"ru": "Мы игра́ем в футбо́л. А ты где?", "uz": "Futbol o'ynayapmiz. Sen qayerdasan?", "start": 13.27, "speaker": "Тиму́р", "repeatStart": 38.04}, {"ru": "Я на ку́рсах, на уро́ке.", "uz": "Kursdaman, darsdaman.", "start": 15.84, "speaker": "Дильно́за", "repeatStart": 43.51}, {"ru": "На уро́ке? И ты говори́шь по телефо́ну?", "uz": "Darsdamisan? Va telefonda gaplashyapsanmi?", "start": 17.71, "speaker": "Тиму́р", "repeatStart": 47.4}, {"ru": "Ой! Пока́!", "uz": "Voy! Xayr!", "start": 21.06, "speaker": "Дильно́за", "repeatStart": 54.63}]}, {"id": "bk-L12-d3", "title": "У́тром, днём, ве́чером — Ertalab, kunduzi, kechqurun", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/L12_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l07-l12/audio/A_L12.jpg", "repeatFrom": 22.63, "durationSec": 57, "lines": [{"ru": "Нигора́, где вы обы́чно у́тром?", "uz": "Nigora, odatda ertalab qayerda bo'lasiz?", "start": 7.92, "speaker": "Анто́н", "repeatStart": 27.39}, {"ru": "У́тром я на рабо́те, в больни́це.", "uz": "Ertalab ishdaman, kasalxonada.", "start": 10.31, "speaker": "Нигора́", "repeatStart": 32.45}, {"ru": "А днём? Что вы де́лаете днём?", "uz": "Kunduzi-chi? Kunduzi nima qilasiz?", "start": 12.86, "speaker": "Анто́н", "repeatStart": 37.88}, {"ru": "Днём я обе́даю в кафе́.", "uz": "Kunduzi kafeda tushlik qilaman.", "start": 15.19, "speaker": "Нигора́", "repeatStart": 42.81}, {"ru": "А ве́чером вы до́ма?", "uz": "Kechqurun uydamisiz?", "start": 17.32, "speaker": "Анто́н", "repeatStart": 47.29}, {"ru": "Обы́чно да. Ве́чером я отдыха́ю.", "uz": "Odatda ha. Kechqurun dam olaman.", "start": 18.81, "speaker": "Нигора́", "repeatStart": 50.53}]}]}