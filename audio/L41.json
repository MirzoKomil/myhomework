   "lines": [
    {
     "who": "Учи́тельница",
     "ru": "Здра́вствуйте! Сади́тесь, пожа́луйста. Откро́йте кни́ги.",
     "uz": "Assalomu alaykum! O'tiring, iltimos. Kitoblarni oching."
