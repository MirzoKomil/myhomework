    {
     "who": "Нигора́",
     "ru": "Хорошо́. А ско́лько сто́ят э́ти очки́?",
     "uz": "Yaxshi. Bu ko'zoynak qancha turadi?"
    },
    {
     "who": "Продаве́ц",
     "ru": "Очки́ сто́ят девяно́сто ты́сяч.",
     "uz": "Ko'zoynak to'qson ming turadi."
