   "lines": [
    {
     "who": "Абдулази́з",
     "ru": "Алло́, Нигора́, ты где?",
     "uz": "Allo, Nigora, qayerdasan?"
    },
    {
     "who": "Нигора́",
     "ru": "Я в апте́ке. А что?",
     "uz": "Dorixonadaman. Nima edi?"
