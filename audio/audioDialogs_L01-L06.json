{"l1783004411232": [{"id": "bk-L01-d1", "title": "В о́фисе — Ofisda", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L01_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L01.jpg", "repeatFrom": 24.35, "durationSec": 65, "lines": [{"ru": "Здра́вствуйте! Меня́ зову́т Анто́н.", "uz": "Assalomu alaykum! Mening ismim Anton.", "start": 7.06, "speaker": "Анто́н", "repeatStart": 29.11}, {"ru": "Здра́вствуйте! Меня́ зову́т Нигора́.", "uz": "Assalomu alaykum! Mening ismim Nigora.", "start": 10.49, "speaker": "Нигора́", "repeatStart": 37.82}, {"ru": "О́чень прия́тно! Где вы живёте?", "uz": "Tanishganimdan xursandman! Qayerda yashaysiz?", "start": 13.38, "speaker": "Анто́н", "repeatStart": 44.01}, {"ru": "Я живу́ в Андижа́не. А вы?", "uz": "Men Andijonda yashayman. Siz-chi?", "start": 15.95, "speaker": "Нигора́", "repeatStart": 49.48}, {"ru": "Я живу́ в Ташке́нте. Я рабо́таю в ба́нке.", "uz": "Men Toshkentda yashayman. Men bankda ishlayman.", "start": 18.46, "speaker": "Анто́н", "repeatStart": 54.81}, {"ru": "А я рабо́таю в больни́це.", "uz": "Men esa kasalxonada ishlayman.", "start": 21.41, "speaker": "Нигора́", "repeatStart": 61.14}]}, {"id": "bk-L01-d2", "title": "На ку́рсах — Kursda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L01_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L01.jpg", "repeatFrom": 20.61, "durationSec": 49, "lines": [{"ru": "Здра́вствуйте! Как вас зову́т?", "uz": "Assalomu alaykum! Ismingiz nima?", "start": 8.24, "speaker": "Учи́тельница", "repeatStart": 25.37}, {"ru": "Меня́ зову́т Бобу́р.", "uz": "Mening ismim Bobur.", "start": 10.39, "speaker": "Бобу́р", "repeatStart": 29.89}, {"ru": "Бобу́р, ско́лько вам лет?", "uz": "Bobur, yoshingiz nechada?", "start": 11.84, "speaker": "Учи́тельница", "repeatStart": 33.09}, {"ru": "Мне два́дцать четы́ре го́да.", "uz": "Men yigirma to'rt yoshdaman.", "start": 13.57, "speaker": "Бобу́р", "repeatStart": 36.67}, {"ru": "Вы рабо́таете и́ли у́читесь?", "uz": "Ishlaysizmi yoki o'qiysizmi?", "start": 15.28, "speaker": "Учи́тельница", "repeatStart": 40.21}, {"ru": "Я учу́сь. Моё хо́бби — футбо́л.", "uz": "Men o'qiyman. Mening hobbim — futbol.", "start": 17.37, "speaker": "Бобу́р", "repeatStart": 44.6}]}, {"id": "bk-L01-d3", "title": "В по́езде — Poyezdda", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L01_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L01.jpg", "repeatFrom": 22.83, "durationSec": 59, "lines": [{"ru": "До́брый день! Меня́ зову́т Шахзо́д.", "uz": "Xayrli kun! Mening ismim Shahzod.", "start": 6.88, "speaker": "Шахзо́д", "repeatStart": 27.59}, {"ru": "До́брый день! А меня́ зову́т Ками́ла.", "uz": "Xayrli kun! Mening ismim esa Kamila.", "start": 9.17, "speaker": "Ками́ла", "repeatStart": 32.43}, {"ru": "О́чень прия́тно! Где вы живёте?", "uz": "Tanishganimdan xursandman! Qayerda yashaysiz?", "start": 11.66, "speaker": "Шахзо́д", "repeatStart": 37.72}, {"ru": "Я живу́ в Ферга́не. А вы?", "uz": "Men Farg'onada yashayman. Siz-chi?", "start": 13.97, "speaker": "Ками́ла", "repeatStart": 42.6}, {"ru": "Я живу́ в Андижа́не. Я рабо́таю.", "uz": "Men Andijonda yashayman. Men ishlayman.", "start": 16.34, "speaker": "Шахзо́д", "repeatStart": 47.62}, {"ru": "А я учу́сь. Моё хо́бби — му́зыка.", "uz": "Men esa o'qiyman. Mening hobbim — musiqa.", "start": 18.73, "speaker": "Ками́ла", "repeatStart": 52.69}]}], "l1784055280406-1": [{"id": "bk-L02-d1", "title": "Отку́да вы? — Qayerdansiz?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L02_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L02.jpg", "repeatFrom": 26.36, "durationSec": 68, "lines": [{"ru": "Здра́вствуйте! Меня́ зову́т Анто́н.", "uz": "Assalomu alaykum! Mening ismim Anton.", "start": 7.86, "speaker": "Анто́н", "repeatStart": 31.12}, {"ru": "О́чень прия́тно! Я Нигора́. Отку́да вы?", "uz": "Tanishganimdan xursandman! Men Nigoraman. Qayerdansiz?", "start": 10.65, "speaker": "Нигора́", "repeatStart": 37.09}, {"ru": "Я из Росси́и, из Москвы́. А вы?", "uz": "Men Rossiyadanman, Moskvadan. Siz-chi?", "start": 14.04, "speaker": "Анто́н", "repeatStart": 44.4}, {"ru": "Я из Узбекиста́на, из Андижа́на.", "uz": "Men O'zbekistondanman, Andijondan.", "start": 16.85, "speaker": "Нигора́", "repeatStart": 50.41}, {"ru": "Вы рабо́таете и́ли у́читесь?", "uz": "Ishlaysizmi yoki o'qiysizmi?", "start": 19.52, "speaker": "Анто́н", "repeatStart": 56.1}, {"ru": "Я рабо́таю. А вы?", "uz": "Men ishlayman. Siz-chi?", "start": 21.45, "speaker": "Нигора́", "repeatStart": 60.13}, {"ru": "А я то́же рабо́таю. В ба́нке.", "uz": "Men esa ham ishlayman. Bankda.", "start": 23.2, "speaker": "Анто́н", "repeatStart": 63.76}]}, {"id": "bk-L02-d2", "title": "Как дела́? — Ishlar qalay?", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L02_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L02.jpg", "repeatFrom": 21.03, "durationSec": 54, "lines": [{"ru": "Приве́т, Дильно́за! Как дела́?", "uz": "Salom, Dilnoza! Ishlar qalay?", "start": 6.78, "speaker": "Тиму́р", "repeatStart": 25.79}, {"ru": "Приве́т! Хорошо́, спаси́бо. А ты как?", "uz": "Salom! Yaxshi, rahmat. O'zing-chi?", "start": 8.89, "speaker": "Дильно́за", "repeatStart": 30.22}, {"ru": "Норма́льно. Како́е у тебя́ хо́бби?", "uz": "Yomon emas. Hobbing nima?", "start": 11.52, "speaker": "Тиму́р", "repeatStart": 35.83}, {"ru": "Моё хо́бби — му́зыка. А у тебя́?", "uz": "Mening hobbim — musiqa. Seniki-chi?", "start": 14.05, "speaker": "Дильно́за", "repeatStart": 41.21}, {"ru": "Моё хо́бби — футбо́л.", "uz": "Mening hobbim — futbol.", "start": 16.44, "speaker": "Тиму́р", "repeatStart": 46.27}, {"ru": "Хорошо́! Пока́, Тиму́р!", "uz": "Yaxshi! Xayr, Timur!", "start": 18.13, "speaker": "Дильно́за", "repeatStart": 49.76}]}, {"id": "bk-L02-d3", "title": "Но́вый сотру́дник — Yangi xodim", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L02_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L02.jpg", "repeatFrom": 18.89, "durationSec": 47, "lines": [{"ru": "Здра́вствуйте! Как вас зову́т?", "uz": "Assalomu alaykum! Ismingiz nima?", "start": 7.1, "speaker": "Администра́тор", "repeatStart": 23.65}, {"ru": "Меня́ зову́т Улугбе́к.", "uz": "Mening ismim Ulug'bek.", "start": 9.41, "speaker": "Улугбе́к", "repeatStart": 28.54}, {"ru": "Ско́лько вам лет?", "uz": "Yoshingiz nechada?", "start": 11.1, "speaker": "Администра́тор", "repeatStart": 32.02}, {"ru": "Мне три́дцать лет.", "uz": "Men o'ttiz yoshdaman.", "start": 12.55, "speaker": "Улугбе́к", "repeatStart": 35.23}, {"ru": "Отку́да вы?", "uz": "Qayerdansiz?", "start": 13.98, "speaker": "Администра́тор", "repeatStart": 38.41}, {"ru": "Я из Андижа́на. Но живу́ в Ташке́нте.", "uz": "Men Andijondanman. Lekin Toshkentda yashayman.", "start": 15.15, "speaker": "Улугбе́к", "repeatStart": 41.33}]}], "l1784055280406-2": [{"id": "bk-L03-d1", "title": "На уро́ке — Darsda", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L03_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L03.jpg", "repeatFrom": 21.33, "durationSec": 54, "lines": [{"ru": "Тиму́р, у тебя́ есть ру́чка?", "uz": "Timur, senda ruchka bormi?", "start": 7.04, "speaker": "Дильно́за", "repeatStart": 26.09}, {"ru": "Да, у меня́ есть ру́чка. Пожа́луйста.", "uz": "Ha, menda ruchka bor. Marhamat.", "start": 9.09, "speaker": "Тиму́р", "repeatStart": 30.39}, {"ru": "Спаси́бо! А кто э́то?", "uz": "Rahmat! Bu kim?", "start": 11.78, "speaker": "Дильно́за", "repeatStart": 36.13}, {"ru": "Э́то Бобу́р. Он студе́нт.", "uz": "Bu Bobur. U talaba.", "start": 14.15, "speaker": "Тиму́р", "repeatStart": 41.15}, {"ru": "У него́ есть тетра́дь?", "uz": "Unda daftar bormi?", "start": 16.14, "speaker": "Дильно́за", "repeatStart": 45.31}, {"ru": "Да, у него́ есть тетра́дь и кни́га.", "uz": "Ha, unda daftar va kitob bor.", "start": 17.83, "speaker": "Тиму́р", "repeatStart": 48.8}]}, {"id": "bk-L03-d2", "title": "Кто э́то? — Bu kim?", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L03_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L03.jpg", "repeatFrom": 19.93, "durationSec": 49, "lines": [{"ru": "Абдулази́з, кто э́то?", "uz": "Abdulaziz, bu kim?", "start": 7.38, "speaker": "Нигора́", "repeatStart": 24.69}, {"ru": "Э́то Анто́н. Он мой колле́га.", "uz": "Bu Anton. U mening hamkasbim.", "start": 9.45, "speaker": "Абдулази́з", "repeatStart": 29.04}, {"ru": "У него́ есть маши́на?", "uz": "Uning mashinasi bormi?", "start": 11.6, "speaker": "Нигора́", "repeatStart": 33.56}, {"ru": "Да, у него́ есть маши́на.", "uz": "Ha, uning mashinasi bor.", "start": 13.17, "speaker": "Абдулази́з", "repeatStart": 36.88}, {"ru": "А соба́ка у него́ есть?", "uz": "Iti-chi, iti bormi?", "start": 15.0, "speaker": "Нигора́", "repeatStart": 40.68}, {"ru": "Нет. Но у него́ есть кот.", "uz": "Yo'q. Lekin uning mushugi bor.", "start": 16.69, "speaker": "Абдулази́з", "repeatStart": 44.17}]}, {"id": "bk-L03-d3", "title": "В магази́не — Do'konda", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L03_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L03.jpg", "repeatFrom": 23.15, "durationSec": 59, "lines": [{"ru": "Здра́вствуйте! У вас есть ру́чки?", "uz": "Assalomu alaykum! Sizlarda ruchka bormi?", "start": 7.72, "speaker": "Анто́н", "repeatStart": 27.91}, {"ru": "Да, у нас есть ру́чки.", "uz": "Ha, bizda ruchkalar bor.", "start": 11.71, "speaker": "Продаве́ц", "repeatStart": 36.71}, {"ru": "А тетра́ди у вас есть?", "uz": "Daftarlar-chi, bormi?", "start": 13.66, "speaker": "Анто́н", "repeatStart": 40.78}, {"ru": "Да, есть. Пожа́луйста.", "uz": "Ha, bor. Marhamat.", "start": 15.25, "speaker": "Продаве́ц", "repeatStart": 44.12}, {"ru": "Спаси́бо! А что э́то?", "uz": "Rahmat! Bu nima?", "start": 17.38, "speaker": "Анто́н", "repeatStart": 48.6}, {"ru": "Э́то кни́га. А э́то телефо́н.", "uz": "Bu kitob. Bu esa telefon.", "start": 19.39, "speaker": "Продаве́ц", "repeatStart": 52.81}]}], "l1784055280406-3": [{"id": "bk-L04-d1", "title": "У кого́ есть слова́рь? — Kimda lug'at bor?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L04_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L04.jpg", "repeatFrom": 24.17, "durationSec": 58, "lines": [{"ru": "У кого́ есть слова́рь?", "uz": "Kimda lug'at bor?", "start": 9.86, "speaker": "Учи́тель", "repeatStart": 28.93}, {"ru": "У меня́ есть слова́рь. Вот он.", "uz": "Menda lug'at bor. Mana u.", "start": 11.65, "speaker": "Нигора́", "repeatStart": 32.65}, {"ru": "Спаси́бо. У кого́ есть вопро́с?", "uz": "Rahmat. Kimda savol bor?", "start": 14.14, "speaker": "Учи́тель", "repeatStart": 37.94}, {"ru": "У меня́ есть вопро́с. Что э́то?", "uz": "Menda savol bor. Bu nima?", "start": 16.91, "speaker": "Нигора́", "repeatStart": 43.85}, {"ru": "Э́то стул. А э́то стол.", "uz": "Bu stul. Bu esa stol.", "start": 19.62, "speaker": "Учи́тель", "repeatStart": 49.64}, {"ru": "Спаси́бо!", "uz": "Rahmat!", "start": 22.07, "speaker": "Нигора́", "repeatStart": 54.84}]}, {"id": "bk-L04-d2", "title": "У нас го́сти! — Bizda mehmonlar!", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L04_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L04.jpg", "repeatFrom": 22.55, "durationSec": 56, "lines": [{"ru": "Нигора́, у нас го́сти!", "uz": "Nigora, bizga mehmon keldi!", "start": 8.22, "speaker": "Абдулази́з", "repeatStart": 27.31}, {"ru": "Хорошо́! У нас есть чай?", "uz": "Yaxshi! Bizda choy bormi?", "start": 10.27, "speaker": "Нигора́", "repeatStart": 31.61}, {"ru": "Да, есть чай и сок.", "uz": "Ha, choy ham, sharbat ham bor.", "start": 12.38, "speaker": "Абдулази́з", "repeatStart": 36.04}, {"ru": "Отли́чно. А кто там?", "uz": "Juda yaxshi. U yerda kim?", "start": 15.03, "speaker": "Нигора́", "repeatStart": 41.69}, {"ru": "Там Анто́н. У него́ есть торт!", "uz": "U yerda Anton. Unda tort bor!", "start": 17.04, "speaker": "Абдулази́з", "repeatStart": 45.9}, {"ru": "Здра́вствуйте, Анто́н! Вот чай.", "uz": "Assalomu alaykum, Anton! Mana choy.", "start": 19.27, "speaker": "Нигора́", "repeatStart": 50.61}]}, {"id": "bk-L04-d3", "title": "У вас есть вре́мя? — Vaqtingiz bormi?", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L04_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L04.jpg", "repeatFrom": 22.18, "durationSec": 56, "lines": [{"ru": "Анто́н, у вас есть вре́мя?", "uz": "Anton, vaqtingiz bormi?", "start": 7.52, "speaker": "Дильно́за", "repeatStart": 26.94}, {"ru": "Да, есть. У вас вопро́с?", "uz": "Ha, bor. Savolingiz bormi?", "start": 9.71, "speaker": "Анто́н", "repeatStart": 31.55}, {"ru": "Да. У вас есть компью́тер?", "uz": "Ha. Sizda kompyuter bormi?", "start": 12.08, "speaker": "Дильно́за", "repeatStart": 36.57}, {"ru": "Нет, у меня́ нет компью́тера.", "uz": "Yo'q, menda kompyuter yo'q.", "start": 14.47, "speaker": "Анто́н", "repeatStart": 41.64}, {"ru": "А у кого́ есть компью́тер?", "uz": "Kimda kompyuter bor unda?", "start": 16.44, "speaker": "Дильно́за", "repeatStart": 45.76}, {"ru": "У Бобу́ра. Вот он, там.", "uz": "Boburda. Mana u, u yerda.", "start": 18.03, "speaker": "Анто́н", "repeatStart": 49.1}, {"ru": "Спаси́бо, Анто́н!", "uz": "Rahmat, Anton!", "start": 19.94, "speaker": "Дильно́за", "repeatStart": 53.08}]}], "l1784055280406-4": [{"id": "bk-L05-d1", "title": "По телефо́ну — Telefonda", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L05_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L05.jpg", "repeatFrom": 19.09, "durationSec": 48, "lines": [{"ru": "Алло́! Что ты де́лаешь?", "uz": "Allo! Nima qilyapsan?", "start": 6.44, "speaker": "Нигора́", "repeatStart": 23.85}, {"ru": "Я обе́даю. А ты что де́лаешь?", "uz": "Tushlik qilyapman. Sen nima qilyapsan?", "start": 8.47, "speaker": "Абдулази́з", "repeatStart": 28.1}, {"ru": "Я отдыха́ю и слу́шаю му́зыку.", "uz": "Dam olyapman va musiqa tinglayapman.", "start": 10.8, "speaker": "Нигора́", "repeatStart": 33.03}, {"ru": "А что де́лают де́ти?", "uz": "Bolalar nima qilyapti?", "start": 13.27, "speaker": "Абдулази́з", "repeatStart": 38.28}, {"ru": "Они́ игра́ют вме́сте.", "uz": "Ular birga o'ynashyapti.", "start": 14.8, "speaker": "Нигора́", "repeatStart": 41.56}, {"ru": "Хорошо́! Пока́!", "uz": "Yaxshi! Xayr!", "start": 16.53, "speaker": "Абдулази́з", "repeatStart": 45.14}]}, {"id": "bk-L05-d2", "title": "В па́рке — Parkda", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L05_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L05.jpg", "repeatFrom": 28.45, "durationSec": 75, "lines": [{"ru": "Приве́т, Дильно́за! Что вы здесь де́лаете?", "uz": "Salom, Dilnoza! Bu yerda nima qilyapsizlar?", "start": 8.32, "speaker": "Анто́н", "repeatStart": 33.21}, {"ru": "Приве́т! Мы гуля́ем. А вы?", "uz": "Salom! Biz sayr qilyapmiz. Siz-chi?", "start": 13.49, "speaker": "Дильно́за", "repeatStart": 45.37}, {"ru": "Я то́же гуля́ю. Вы изуча́ете ру́сский?", "uz": "Men ham sayr qilyapman. Siz rus tilini o'rganyapsizmi?", "start": 16.9, "speaker": "Анто́н", "repeatStart": 52.73}, {"ru": "Да, изуча́ю. Я чита́ю и слу́шаю.", "uz": "Ha, o'rganyapman. O'qiyman va tinglayman.", "start": 19.63, "speaker": "Дильно́за", "repeatStart": 58.56}, {"ru": "Вы меня́ понима́ете?", "uz": "Meni tushunyapsizmi?", "start": 23.42, "speaker": "Анто́н", "repeatStart": 66.78}, {"ru": "Да, понима́ю! Спаси́бо.", "uz": "Ha, tushunyapman! Rahmat.", "start": 25.03, "speaker": "Дильно́за", "repeatStart": 70.14}]}, {"id": "bk-L05-d3", "title": "До́ма — Uyda", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L05_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L05.jpg", "repeatFrom": 19.55, "durationSec": 51, "lines": [{"ru": "Сардо́р, что ты де́лаешь?", "uz": "Sardor, nima qilyapsan?", "start": 6.24, "speaker": "Нигора́", "repeatStart": 24.31}, {"ru": "Я игра́ю, ма́ма.", "uz": "O'ynayapman, oyi.", "start": 8.41, "speaker": "Сардо́р", "repeatStart": 28.88}, {"ru": "А что де́лает Маржона́?", "uz": "Marjona nima qilyapti?", "start": 9.94, "speaker": "Нигора́", "repeatStart": 32.16}, {"ru": "Она́ чита́ет кни́гу.", "uz": "U kitob o'qiyapti.", "start": 12.11, "speaker": "Сардо́р", "repeatStart": 36.73}, {"ru": "А па́па? Что он де́лает?", "uz": "Dadang-chi? U nima qilyapti?", "start": 13.64, "speaker": "Нигора́", "repeatStart": 40.01}, {"ru": "Па́па отдыха́ет. Он слу́шает му́зыку.", "uz": "Dadam dam olyapti. U musiqa tinglayapti.", "start": 15.83, "speaker": "Сардо́р", "repeatStart": 44.62}]}], "l1784055280406-5": [{"id": "bk-L06-d1", "title": "Ты рабо́таешь? — Ishlayapsanmi?", "trackNo": 1, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L06_d1.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L06.jpg", "repeatFrom": 23.51, "durationSec": 63, "lines": [{"ru": "Нигора́, приве́т! Ты рабо́таешь?", "uz": "Nigora, salom! Ishlayapsanmi?", "start": 6.74, "speaker": "Бобу́р", "repeatStart": 28.27}, {"ru": "Нет, я не рабо́таю. Я отдыха́ю.", "uz": "Yo'q, ishlamayapman. Dam olyapman.", "start": 10.77, "speaker": "Нигора́", "repeatStart": 37.66}, {"ru": "А Абдулази́з? Что он де́лает?", "uz": "Abdulaziz-chi? U nima qilyapti?", "start": 13.64, "speaker": "Бобу́р", "repeatStart": 43.8}, {"ru": "Он сейча́с гото́вит.", "uz": "U hozir ovqat pishiryapti.", "start": 16.39, "speaker": "Нигора́", "repeatStart": 49.67}, {"ru": "А де́ти? Они́ спят?", "uz": "Bolalar-chi? Ular uxlayaptimi?", "start": 17.9, "speaker": "Бобу́р", "repeatStart": 52.93}, {"ru": "Нет, они́ не спят. Они́ игра́ют.", "uz": "Yo'q, ular uxlamayapti. Ular o'ynayapti.", "start": 20.15, "speaker": "Нигора́", "repeatStart": 57.68}]}, {"id": "bk-L06-d2", "title": "В саду́ — Bog'da", "trackNo": 2, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L06_d2.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L06.jpg", "repeatFrom": 25.01, "durationSec": 62, "lines": [{"ru": "Маржона́, что ты де́лаешь?", "uz": "Marjona, nima qilyapsan?", "start": 8.74, "speaker": "Абдулази́з", "repeatStart": 29.77}, {"ru": "Я полива́ю цветы́.", "uz": "Gullarga suv quyyapman.", "start": 10.99, "speaker": "Маржона́", "repeatStart": 34.52}, {"ru": "Молоде́ц! А Сардо́р то́же полива́ет?", "uz": "Barakalla! Sardor ham suv quyyaptimi?", "start": 12.82, "speaker": "Абдулази́з", "repeatStart": 38.32}, {"ru": "Нет, он не полива́ет. Он смо́трит футбо́л.", "uz": "Yo'q, u suv quymayapti. U futbol ko'ryapti.", "start": 15.93, "speaker": "Маржона́", "repeatStart": 45.01}, {"ru": "А ма́ма? Что она́ де́лает?", "uz": "Oying-chi? U nima qilyapti?", "start": 19.64, "speaker": "Абдулази́з", "repeatStart": 53.04}, {"ru": "Ма́ма гото́вит и поёт.", "uz": "Oyim ovqat pishiryapti va qo'shiq aytyapti.", "start": 21.79, "speaker": "Маржона́", "repeatStart": 57.57}]}, {"id": "bk-L06-d3", "title": "На пра́зднике — Bayramda", "trackNo": 3, "audioUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/L06_d3.mp3", "bookPart": 1, "coverUrl": "https://raw.githubusercontent.com/MirzoKomil/myhomework/audio/l04-l06/audio/A_L06.jpg", "repeatFrom": 22.78, "durationSec": 59, "lines": [{"ru": "Дильно́за, вы танцу́ете?", "uz": "Dilnoza, raqs tushasizmi?", "start": 7.08, "speaker": "Анто́н", "repeatStart": 27.54}, {"ru": "Нет, я не танцу́ю. Я слу́шаю.", "uz": "Yo'q, raqs tushmayman. Tinglayapman.", "start": 9.17, "speaker": "Дильно́за", "repeatStart": 31.93}, {"ru": "А что де́лают Нигора́ и Бобу́р?", "uz": "Nigora va Bobur nima qilyapti?", "start": 11.8, "speaker": "Анто́н", "repeatStart": 37.53}, {"ru": "Они́ танцу́ют вме́сте.", "uz": "Ular birga raqs tushyapti.", "start": 14.51, "speaker": "Дильно́за", "repeatStart": 43.32}, {"ru": "А вы поёте?", "uz": "Siz qo'shiq aytasizmi?", "start": 16.42, "speaker": "Анто́н", "repeatStart": 47.3}, {"ru": "Да, я пою́. А вы?", "uz": "Ha, aytaman. Siz-chi?", "start": 17.77, "speaker": "Дильно́за", "repeatStart": 50.4}, {"ru": "Нет, я не пою́. Я слу́шаю!", "uz": "Yo'q, men aytmayman. Men tinglayman!", "start": 19.62, "speaker": "Анто́н", "repeatStart": 54.25}]}]}