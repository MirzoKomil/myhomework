# ── Asosiy sozlamalar ────────────────────────────────────────────────────────
PORT=3000

# ── MAJBURIY: ishlab chiqarish uchun o'zgartiring ────────────────────────────
# Kamida 32 ta tasodifiy belgi: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Webhook uchun alohida sir so'z (landing sahifalardan lid qabul qilish).
#
# VERGUL bilan bir nechta kalit yozish mumkin — kalitni lid yo'qotmasdan
# almashtirish uchun. Birinchisi asosiy (yangi), qolganlari o'chirilishi
# kutilayotgan eskilari:
#   1. LEADS_WEBHOOK_SECRET=<YANGI>,<ESKI>   → ikkalasi ham ishlaydi
#   2. Saytlardagi skriptni <YANGI> ga o'zgartiring (integrations/*.js)
#   3. Loglarda faqat "mos=1-kalit" ko'ringach → <ESKI> ni olib tashlang
LEADS_WEBHOOK_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://myhomework:strong_password@localhost:5432/myhomework
DATABASE_SSL=false

# ── CORS: ruxsat berilgan domenlar (vergul bilan ajratilgan) ─────────────────
ALLOWED_ORIGINS=https://myhomework.uz,https://www.myhomework.uz

# ── Fayllar (deployment vaqtida saqlansin) ───────────────────────────────────
# DATA_DIR=/var/lib/myhomework

# ── Admin parolini bir marta reset qilish (ishlatib o'chiring) ───────────────
# ADMIN_INIT_PASSWORD=admin123

# ── Eskiz.uz SMS shlyuzi (SMS rassilka bo'limi) ──────────────────────────────
# DIQQAT: my.eskiz.uz shaxsiy kabinet (sayt) login/paroli emas — alohida
# "SMS shlyuzi" (API) login/paroli kerak, my.eskiz.uz dashboardidan olinadi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Tasdiqlangan jo'natuvchi nickname (moderatsiyadan o'tgan). Bo'sh qoldirilsa
# standart sandbox nickname "4546" ishlatiladi (faqat test rejimida ishlaydi).
ESKIZ_SENDER_NICKNAME=4546

# ── Meta Lead Ads webhook ──────────────────────────────────────────────────
# Meta Developers va Railway Variables bo'limida yaratiladi. Bularni Git'ga
# kiritmang; xususan META_APP_SECRET va META_PAGE_ACCESS_TOKEN maxfiy.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# `openssl rand -hex 32` bilan yaratilgan alohida tasodifiy satr.
META_WEBHOOK_VERIFY_TOKEN=
# Lead forma IDlarini vergul bilan ajrating. Forma ro'yxatda bo'lmasa default
# til ishlatiladi.
META_RUSSIAN_FORM_IDS=
META_ENGLISH_FORM_IDS=
META_DEFAULT_LANGUAGE=english

# ── Tashqi (read-only) API kalitlari ────────────────────────────────────────
# Ikkalasi ham `openssl rand -hex 32` bilan yaratiladi. O'rnatilmasa, tegishli
# endpointlar butunlay yopiq qoladi (503) — zaxira kalit yo'q.
# /api/public/sales/* — sotuv voronkasi va lidlar (reklama tahlili uchun).
PUBLIC_SALES_API_KEY=
# /api/public/crm/*  — CRM'ning qolgan barcha bo'limlari (o'quvchilar,
# davomat, moliya, HR va h.k.). ATAYIN ALOHIDA kalit: sotuv kaliti sizib
# chiqsa, u butun CRM'ni ocholmasligi kerak.
PUBLIC_CRM_API_KEY=

# ── CAPI.uz → Meta Conversions API (chiquvchi) ──────────────────────────────
# Lid yaratilganda va HAR BIR bosqich o'zgarganda CAPI.uz'ga POST ketadi,
# u esa buni Facebook Conversions API'ga o'giradi. Token o'rnatilmasa
# integratsiya jim o'chiq qoladi (lidlar Meta'ga yuborilmaydi).
# Token CAPI kabinetida bir marta ko'rsatiladi — yo'qolsa CAPI jamoasidan
# yangisini so'rash kerak. Bu qiymat parol bilan barobar: Git'ga kiritmang.
CAPI_UZ_TOKEN=
# Standart: https://capi.uz/api/inbound — odatda o'zgartirish shart emas.
CAPI_UZ_URL=
