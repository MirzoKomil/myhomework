# ── Asosiy sozlamalar ────────────────────────────────────────────────────────
PORT=3000

# ── MAJBURIY: ishlab chiqarish uchun o'zgartiring ────────────────────────────
# Kamida 32 ta tasodifiy belgi: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Webhook uchun alohida sir so'z
LEADS_WEBHOOK_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://myhomework:strong_password@localhost:5432/myhomework
DATABASE_SSL=false

# ── CORS: ruxsat berilgan domenlar (vergul bilan ajratilgan) ─────────────────
ALLOWED_ORIGINS=https://myhomework.uz,https://www.myhomework.uz

# ── Fayllar (deployment vaqtida saqlansin) ───────────────────────────────────
# DATA_DIR=/var/lib/myhomework

# ── Admin parolini bir marta reset qilish (ishlatib o'chiring) ───────────────
# ADMIN_INIT_PASSWORD=admin123

# ── Eskiz.uz SMS shlyuzi (SMS rassilka bo'limi) ──────────────────────────────
# DIQQAT: my.eskiz.uz shaxsiy kabinet (sayt) login/paroli emas — alohida
# "SMS shlyuzi" (API) login/paroli kerak, my.eskiz.uz dashboardidan olinadi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Tasdiqlangan jo'natuvchi nickname (moderatsiyadan o'tgan). Bo'sh qoldirilsa
# standart sandbox nickname "4546" ishlatiladi (faqat test rejimida ishlaydi).
ESKIZ_SENDER_NICKNAME=4546

# ── Meta Lead Ads webhook ──────────────────────────────────────────────────
# Meta Developers va Railway Variables bo'limida yaratiladi. Bularni Git'ga
# kiritmang; xususan META_APP_SECRET va META_PAGE_ACCESS_TOKEN maxfiy.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# `openssl rand -hex 32` bilan yaratilgan alohida tasodifiy satr.
META_WEBHOOK_VERIFY_TOKEN=
# Lead forma IDlarini vergul bilan ajrating. Forma ro'yxatda bo'lmasa default
# til ishlatiladi.
META_RUSSIAN_FORM_IDS=
META_ENGLISH_FORM_IDS=
META_DEFAULT_LANGUAGE=english
